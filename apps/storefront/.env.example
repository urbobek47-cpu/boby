# Cloudinary (image delivery — BUILD-PLAN §3, §5.4).
# The storefront references images by Cloudinary public id and builds delivery
# URLs from this cloud name. Defaults to the public "demo" cloud when unset, so
# the app renders real sample photos out of the box for review.
# Set this to BOBY's own Cloudinary cloud name, then use BOBY's public ids.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=demo

# Canonical site origin — used for metadataBase, canonical/hreflang URLs,
# sitemap.xml and robots.txt. Defaults to https://boby.co.il. Override on
# preview deploys (e.g. the Vercel preview URL).
NEXT_PUBLIC_SITE_URL=https://boby.co.il
